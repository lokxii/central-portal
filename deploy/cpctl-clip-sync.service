[Unit]
Description=Central Portal clipboard sync
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Put CP_SERVER, CP_CA (optional) and WAYLAND_DISPLAY here.
EnvironmentFile=%h/.config/central-portal/sync.env
ExecStart=/usr/local/bin/cpctl clip sync
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
